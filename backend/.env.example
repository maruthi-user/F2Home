# ============================================================
# LOCAL EMAIL OVERRIDES - TEMPLATE
# ------------------------------------------------------------
# Copy this file to ".env" (same folder) and fill in your own
# credentials. ".env" is git-ignored and NEVER committed.
#
# Why: local networks commonly block SMTP ports 25/465/587.
# Brevo/SendGrid alternate port 2525 stays reachable, so local
# development uses it. Hosted environments run without a .env file:
# the dev backend on Render takes its values from the dashboard env
# vars (see render.yaml), production will use its own env.
#
# PRECEDENCE (Spring Boot):
#   OS environment variables  >  .env file  >  application.properties
#
# NOTE: keys must be written exactly as shown (property style).
# ============================================================

spring.mail.host=smtp-relay.brevo.com
spring.mail.port=2525

# Brevo: Profile -> SMTP & API -> SMTP key
#   username = the login shown next to the key (or account email)
spring.mail.username=
spring.mail.password=

# TLS: port 2525 uses STARTTLS (not implicit SSL)
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true
spring.mail.properties.mail.smtp.ssl.enable=false
spring.mail.properties.mail.smtp.connectiontimeout=10000
spring.mail.properties.mail.smtp.timeout=15000
spring.mail.properties.mail.smtp.writetimeout=15000

# Optional local overrides (uncomment if needed)
# frontend.url=http://f2home.com

# ============================================================
# DEV / PROD DATABASE + JWT SECRET
# ------------------------------------------------------------
# Required when running with -Dspring.profiles.active=dev or prod - those
# profiles reference these via ${...} placeholders instead of hardcoding
# real values (see application-dev.properties / application-prod.properties).
# Not needed for the "local" profile, which points at your own local Postgres.
# Dev uses a Neon database: paste the pooled connection string from the Neon
# console (keep sslmode=require and prepareThreshold=0 for the pooler).
# ============================================================
DB_URL=jdbc:postgresql://HOST:PORT/DBNAME?sslmode=require&prepareThreshold=0
DB_USERNAME=
DB_PASSWORD=

# Generate with: openssl rand -base64 32
# Use a DIFFERENT value for dev vs prod.
F2HOME_JWT_SECRET=
